# ---------------------------------------------------------------
# Expense, Budget and Reimbursement Management System
# Local development .gitignore
# ---------------------------------------------------------------

# Dependencies
node_modules/
**/node_modules/

# Environment files and secrets (never commit real credentials)
.env
.env.local
.env.*.local
*.env
!*.env.example
atlas-credentials.env

# Runtime uploads (sample placeholder is kept)
backend/uploads/*
!backend/uploads/.gitkeep

# Build output
frontend/build/
frontend/dist/
frontend/.vite/

# Test coverage
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Scratch / temporary local scripts and files
tmp-*
_*

# Submission artifact
*.zip

