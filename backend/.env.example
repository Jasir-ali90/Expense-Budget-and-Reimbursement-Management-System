# ---------------------------------------------------------------
# Backend environment example
# Copy this file to ".env" and adjust the values for your machine.
# Do NOT commit the real .env file.
# ---------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Local MongoDB (no Atlas / no cloud database is required)
MONGO_URI=mongodb://127.0.0.1:27017/expense_management_db

# Separate database used ONLY by `npm test`.
# The suite clears every collection before each test, so it refuses to run
# without this value. Point it at a local database you do not mind wiping.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/expense_management_test_db

# Authentication
JWT_SECRET=replace_with_a_long_random_local_secret
JWT_EXPIRES_IN=1d

# Receipt / invoice uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Profile picture uploads (smaller cap than receipts)
MAX_AVATAR_SIZE=2097152

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Number of days before a pending approval is flagged as overdue
SLA_DAYS=3
